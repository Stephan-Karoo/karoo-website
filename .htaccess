<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ══════════════════════════════════════════════════════════════
#  Karoo Media — Apache configuration (SiteGround)
#  Purpose: clean URLs — serve .html pages without the extension
# ══════════════════════════════════════════════════════════════

Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# ── 301: /index.html → / ──────────────────────────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ── 301: /page.html → /page ──────────────────────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^./?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── 301: /dir/page.html → /dir/page ─────────────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^./?]+)/([^./?]+)\.html[\s?] [NC]
RewriteRule ^ /%1/%2 [R=301,L]

# ── Internal rewrite: /page → /page.html ─────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^./]+)$ $1.html [L]

# ── Internal rewrite: /dir/page → /dir/page.html ────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^./]+)/([^./]+)$ $1/$2.html [L]
